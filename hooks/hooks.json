{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/codex_adapter.py\" inject_instructions",
            "commandWindows": "python \"${CLAUDE_PLUGIN_ROOT}\\scripts\\codex_adapter.py\" inject_instructions",
            "timeout": 15,
            "additionalContextLimit": 20000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/codex_adapter.py\" cold_cache_guard",
            "commandWindows": "python \"${CLAUDE_PLUGIN_ROOT}\\scripts\\codex_adapter.py\" cold_cache_guard",
            "timeout": 15,
            "additionalContextLimit": 20000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(collaborationspawn_agent|collaboration[._]?spawn_agent|SpawnAgent|spawn_agent|collab__spawn_agent|collab\\.spawn_agent|create_agent|Agent|Task|Workflow|TaskCreate)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/codex_adapter.py\" ledger_guard_spawn",
            "commandWindows": "python \"${CLAUDE_PLUGIN_ROOT}\\scripts\\codex_adapter.py\" ledger_guard_spawn",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "^(Bash|shell|exec|local_shell|container_exec|run_command)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/codex_adapter.py\" destructive_guard",
            "commandWindows": "python \"${CLAUDE_PLUGIN_ROOT}\\scripts\\codex_adapter.py\" destructive_guard",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(apply_patch|applypatch|write_file|edit_file|create_file|Write|Bash|shell|exec|local_shell)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/codex_adapter.py\" ledger_guard_write",
            "commandWindows": "python \"${CLAUDE_PLUGIN_ROOT}\\scripts\\codex_adapter.py\" ledger_guard_write",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|applypatch|write_file|edit_file|create_file|Write|Edit|MultiEdit|Bash|shell|exec|local_shell)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/codex_adapter.py\" ledger_bind",
            "commandWindows": "python \"${CLAUDE_PLUGIN_ROOT}\\scripts\\codex_adapter.py\" ledger_bind",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/codex_adapter.py\" ledger_guard_stop",
            "commandWindows": "python \"${CLAUDE_PLUGIN_ROOT}\\scripts\\codex_adapter.py\" ledger_guard_stop",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/codex_adapter.py\" cleanup_session_cache",
            "commandWindows": "python \"${CLAUDE_PLUGIN_ROOT}\\scripts\\codex_adapter.py\" cleanup_session_cache",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
